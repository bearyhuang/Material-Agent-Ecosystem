# ---- BOT Chain 链层配置（复制为 blockchain/.env 后填写；.env 绝不进 git）----
# 用法：cp blockchain/.env.example blockchain/.env

# 0 = 关闭链层（全链路照跑，锚定请求落 backend/artifacts/chain/anchor_queue.jsonl）
FS_CHAIN=0

# ===== 网络 =====
# 主网（最终提交目标）：Chain ID 677, RPC https://rpc.botchain.ai
BOT_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_ID=677
BOT_EXPLORER=https://scan.botchain.ai

# ---- 直连模式（2026-10-13 实测有效，无需任何代理）----
# rpc.botchain.ai 的 DNS 被投毒（返回 Facebook 段 IP），且带明文 SNI=rpc.botchain.ai
# 的 TLS ClientHello 会被 RST 注入（实测 read ECONNRESET）。
# 解法：直连真实 IP + SNI 用 ELB 默认证书名 + HTTP Host 头路由。
#   rpc.botchain.ai CNAME → borh-prod-public-eks-376a7c05267175ef.elb.ap-northeast-1.amazonaws.com
#   真实 IP 52.198.35.211（AWS ELB，东京；会变，失效时用上面的 CNAME 重新解析）
#   ⚠️ 早期"不发 SNI"的方案已失效（2026-10-13 复测 ECONNRESET），必须用下面的 SNI。
# 设了 BOT_RPC_IP 就走直连，BOT_RPC_URL 被忽略。
BOT_RPC_IP=52.198.35.211
BOT_RPC_HOST=rpc.botchain.ai
BOT_RPC_SNI=fluxlayer.xyz

# 部署/写链私钥（0x 开头，64 hex）。绝不入库、绝不进事件、绝不进日志。
BOT_PRIVATE_KEY=

# 部署后回填（blockchain/mae.mjs deploy 会打印这行）
BOT_CONTRACT=

# 钱包地址（Agent 身份注册时作为 wallet_address）
BOT_WALLET=0x4Bd9a6ab15329F592f885f7d3891406178c4070f

# ERC-8004 Agent 身份注册（Agent OS API；接口路径待核验，见 docs/ 内 ai4s01）
BOT_AGENTOS_URL=
BOT_AGENTOS_TOKEN=
